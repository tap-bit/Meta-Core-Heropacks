{
  "name": "meta-core-heropacks",
  "version": "1.0.0",
  "private": true,
  "description": "Meta Core heropack showcase website",
  "scripts": {
    "install:all": "npm install && npm install --prefix client",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "node server/index.js",
    "set-code": "node server/set-code.js",
    "test": "node --test server/app.test.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^2.0.2"
  }
}
